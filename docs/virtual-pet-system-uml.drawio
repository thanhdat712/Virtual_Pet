  <diagram id="api-classes" name="03 - Các lớp API và lưu trữ khi chạy">
    <mxGraphModel dx="2600" dy="1500" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2800" pageHeight="1700" math="0" shadow="0"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="p-title" value="&lt;b&gt;SƠ ĐỒ LỚP API VÀ LƯU TRỮ KHI CHẠY&lt;/b&gt;&lt;br&gt;Mũi tên liền thể hiện luồng route đang chạy; khung nét đứt đánh dấu mô-đun độc lập không được route() gọi." style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1600" height="60" as="geometry" /></mxCell>
      <mxCell id="p-http" value="&lt;b&gt;HttpServer&lt;/b&gt;&lt;hr&gt;+ Handler = function&amp;lt;HttpResponse(const HttpRequest&amp;)&amp;gt;&lt;br&gt;- handler_ : Handler; lastError_ : string; wsaStarted_ : bool&lt;hr&gt;+ setHandler(handler); listen(host,port) : bool; lastError() const" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#EAF7EE;strokeColor=#4D9A69;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="420" height="190" as="geometry" /></mxCell>
      <mxCell id="p-request" value="&lt;b&gt;HttpRequest (cấu trúc)&lt;/b&gt;&lt;hr&gt;+ method,path,query,body : string&lt;br&gt;+ headers : map&amp;lt;string,string&amp;gt;&lt;hr&gt;+ header(name) const : string" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="420" height="155" as="geometry" /></mxCell>
      <mxCell id="p-response" value="&lt;b&gt;HttpResponse (cấu trúc)&lt;/b&gt;&lt;hr&gt;+ status : int; contentType,body : string&lt;br&gt;+ extraHeaders : map&amp;lt;string,string&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="420" height="130" as="geometry" /></mxCell>
      <mxCell id="p-route" value="&lt;b&gt;route(Database&amp;,AuthFailures&amp;,HttpRequest const&amp;)&lt;/b&gt;&lt;br&gt;Hàm tự do trong server_main.cpp&lt;br&gt;Điều phối endpoint, đọc cookie phiên, kiểm tra dữ liệu đầu vào và ánh xạ kết quả sang HTTP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#4D9A69;fontSize=13;" vertex="1" parent="1"><mxGeometry x="550" y="130" width="450" height="140" as="geometry" /></mxCell>
      <mxCell id="p-db" value="&lt;b&gt;Server::Database (đang chạy)&lt;/b&gt;&lt;hr&gt;- db_ : sqlite3*; lastError_ : string&lt;hr&gt;+ open/close/runSchema/seedExercisesIfEmpty/lastError&lt;br&gt;+ tài khoản: emailExists, xác minh email, pendingEmailChange, đặt lại/đổi mật khẩu, usernameExists, createUser, verifyLogin, touchLastLogin&lt;br&gt;+ phiên đăng nhập: createSession/userIdForToken/revokeSession&lt;br&gt;+ người dùng/cửa hàng: getUserById/setSoundEnabled/listInventory/listEquipment/purchase&lt;br&gt;+ thú cưng: getPet/renamePet/savePetProfile/feed/performPetAction/equipDecoration/unequipDecoration&lt;br&gt;+ bài tập: listExercises/exerciseExists/listProgress/recordSubmission&lt;br&gt;+ Study: getStudyState/updateStudyActivity/completeStudyStage&lt;br&gt;+ Practice: getPracticeState/updatePracticeActivity/start/abandon/finishPracticeGame&lt;br&gt;+ bài nộp mã: createCodeSubmission/getCodeSubmission&lt;br&gt;- exec(sql)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#EAF7EE;strokeColor=#4D9A69;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="120" width="720" height="500" as="geometry" /></mxCell>
      <mxCell id="p-catalog" value="&lt;b&gt;Các hàm tự do của Catalog&lt;/b&gt;&lt;hr&gt;+ shopCatalog() : const JSON&amp; (GET /api/shop)&lt;br&gt;+ shopItem(id) : const JSON* (tra cứu khi mua hàng)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="340" width="450" height="135" as="geometry" /></mxCell>
      <mxCell id="p-sql" value="&lt;b&gt;Schema SQLite khi chạy&lt;/b&gt;&lt;br&gt;users, pets, sessions, inventory, equipped_decorations, purchase_transactions, study/practice state, exercises, submissions, code submissions, reward ledger" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1210" y="720" width="510" height="160" as="geometry" /></mxCell>
      <mxCell id="p-row" value="&lt;b&gt;Các bản ghi dữ liệu API công khai (cấu trúc)&lt;/b&gt;&lt;hr&gt;UserRow: id,username,email,coins,soundEnabled,emailVerified&lt;br&gt;PetRow: userId,name,species,speciesChosen,level,happiness,hunger,energy,sleepRemainingSeconds&lt;br&gt;ExerciseRow: id,title,description,difficulty,maxScore&lt;br&gt;ProgressRow: exerciseId,status,bestScore,attempts,completedAt&lt;br&gt;StudyStateRow: points,coins,level,happiness,hunger,energy,completedStages&lt;br&gt;PracticeStateRow: points,bestScore,coins,level,happiness,hunger,energy&lt;br&gt;InventoryRow: id,quantity; EquipmentRow: slot,itemId" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9DE;strokeColor=#C6B45D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="960" height="250" as="geometry" /></mxCell>
      <mxCell id="p-if-user" value="&lt;b&gt;&amp;lt;&amp;lt;giao diện&amp;gt;&amp;gt; IUserRepository&lt;/b&gt;&lt;hr&gt;+ findById/Username/Email&lt;br&gt;+ createUser/updatePassword/updateLastLogin/softDelete&lt;br&gt;+ getCoins/setCoins/addCoins" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="440" height="180" as="geometry" /></mxCell>
      <mxCell id="p-if-pet" value="&lt;b&gt;&amp;lt;&amp;lt;giao diện&amp;gt;&amp;gt; IPetRepository&lt;/b&gt;&lt;hr&gt;+ getPetByUserId/savePet/renamePet/updateStats" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1110" width="350" height="150" as="geometry" /></mxCell>
      <mxCell id="p-if-inv" value="&lt;b&gt;&amp;lt;&amp;lt;giao diện&amp;gt;&amp;gt; IInventoryRepository&lt;/b&gt;&lt;hr&gt;+ getInventory/getQuantity/hasItem&lt;br&gt;+ setItemQuantity/addItem/removeItem/clear" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="1110" width="390" height="160" as="geometry" /></mxCell>
      <mxCell id="p-if-game" value="&lt;b&gt;&amp;lt;&amp;lt;giao diện&amp;gt;&amp;gt; IGameRepository&lt;/b&gt;&lt;hr&gt;+ loadGame/saveGame/createInitialGame" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1310" y="1110" width="350" height="145" as="geometry" /></mxCell>
      <mxCell id="p-impl-user" value="&lt;b&gt;UserRepository : IUserRepository&lt;/b&gt;&lt;hr&gt;- db : DatabaseConnection&amp;&lt;br&gt;+ các thao tác theo interface" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1370" width="380" height="120" as="geometry" /></mxCell>
      <mxCell id="p-impl-pet" value="&lt;b&gt;PetRepository : IPetRepository&lt;/b&gt;&lt;hr&gt;- db : DatabaseConnection&amp;&lt;br&gt;+ các thao tác theo interface" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1370" width="380" height="120" as="geometry" /></mxCell>
      <mxCell id="p-impl-inv" value="&lt;b&gt;InventoryRepository : IInventoryRepository&lt;/b&gt;&lt;hr&gt;- db : DatabaseConnection&amp;&lt;br&gt;+ các thao tác theo interface" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="1370" width="430" height="120" as="geometry" /></mxCell>
      <mxCell id="p-impl-game" value="&lt;b&gt;GameRepository : IGameRepository&lt;/b&gt;&lt;hr&gt;- db : DatabaseConnection&amp;&lt;br&gt;- userRepo : UserRepository; petRepo : PetRepository; inventoryRepo : InventoryRepository&lt;br&gt;+ loadGame/saveGame/createInitialGame/getters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="1340" width="550" height="170" as="geometry" /></mxCell>
      <mxCell id="p-conn" value="&lt;b&gt;DatabaseConnection&lt;/b&gt;&lt;hr&gt;- db : sqlite3*; dbPath,lastErrorMessage : string&lt;hr&gt;+ open/close/isOpen/execute/initializeSchema/getRawHandle/getPath/getLastError&lt;br&gt;+ chỉ cho phép di chuyển; quản lý tài nguyên theo RAII" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1900" y="1100" width="500" height="190" as="geometry" /></mxCell>
      <mxCell id="p-stmt" value="&lt;b&gt;Statement&lt;/b&gt;&lt;hr&gt;- stmt : sqlite3_stmt*; dbHandle : sqlite3*&lt;hr&gt;+ bindInt/Int64/Double/String/Null; step/execute&lt;br&gt;+ getInt/Int64/Double/String/isNull; reset/clearBindings&lt;br&gt;+ chỉ cho phép di chuyển; quản lý tài nguyên theo RAII" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1900" y="1330" width="500" height="180" as="geometry" /></mxCell>
      <mxCell id="p-tx" value="&lt;b&gt;Transaction&lt;/b&gt;&lt;hr&gt;- db : sqlite3*; committed,rolledBack : bool&lt;hr&gt;+ commit/rollback/isCompleted&lt;br&gt;+ chỉ cho phép di chuyển; destructor tự rollback nếu giao dịch chưa hoàn tất" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1900" y="1540" width="500" height="140" as="geometry" /></mxCell>
      <mxCell id="p-auth" value="&lt;b&gt;AuthService (mô-đun độc lập)&lt;/b&gt;&lt;hr&gt;- database : sqlite3*; databaseMutex : mutex&lt;hr&gt;+ registerUser/login/loginByEmail/currentSession/logout/initializeSchema&lt;br&gt;Không được route() của máy chủ đang chạy sử dụng" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="440" height="180" as="geometry" /></mxCell>
      <mxCell id="p-e1" edge="1" parent="1" source="p-http" target="p-request" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" value="nhận" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e2" edge="1" parent="1" source="p-http" target="p-response" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" value="trả về" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e3" edge="1" parent="1" source="p-http" target="p-route" style="endArrow=block;html=1;strokeWidth=2;endSize=12;endFill=1;" value="gọi callback" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e4" edge="1" parent="1" source="p-route" target="p-db" style="endArrow=block;html=1;strokeWidth=2;endSize=12;endFill=1;" value="các lời gọi trực tiếp đang chạy" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e5" edge="1" parent="1" source="p-route" target="p-catalog" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" value="GET /api/shop" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e6" edge="1" parent="1" source="p-db" target="p-sql" style="endArrow=block;html=1;strokeWidth=2;endSize=12;endFill=1;" value="SQL" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e17" edge="1" parent="1" source="p-db" target="p-catalog" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" value="mua hàng/cho ăn gọi shopItem" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p-e7" edge="1" parent="1" source="p-impl-user" target="p-if-user" style="endArrow=block;endFill=0;html=1;strokeWidth=2;endSize=12;" value="hiện thực" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e8" edge="1" parent="1" source="p-impl-pet" target="p-if-pet" style="endArrow=block;endFill=0;html=1;strokeWidth=2;endSize=12;" value="hiện thực" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e9" edge="1" parent="1" source="p-impl-inv" target="p-if-inv" style="endArrow=block;endFill=0;html=1;strokeWidth=2;endSize=12;" value="hiện thực" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e10" edge="1" parent="1" source="p-impl-game" target="p-if-game" style="endArrow=block;endFill=0;html=1;strokeWidth=2;endSize=12;" value="hiện thực" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p-e11" edge="1" parent="1" source="p-impl-game" target="p-conn" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" value="tham chiếu (&amp;)" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e12" edge="1" parent="1" source="p-impl-user" target="p-conn" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" value="tham chiếu (&amp;)" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e13" edge="1" parent="1" source="p-impl-pet" target="p-conn" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" value="tham chiếu (&amp;)" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e14" edge="1" parent="1" source="p-impl-inv" target="p-conn" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" value="tham chiếu (&amp;)" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p-e15" edge="1" parent="1" source="p-impl-game" target="p-stmt" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" value="khởi tạo helper" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p-e16" edge="1" parent="1" source="p-impl-game" target="p-tx" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" value="sử dụng helper" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p-note" value="Các phần triển khai Repository và AuthService tồn tại độc lập, không thuộc luồng HTTP đang chạy. GameRepository giữ DatabaseConnection bằng tham chiếu (không phải hợp thành). Repository dùng Statement/Transaction; Statement không thuộc quyền sở hữu của DatabaseConnection." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9DE;strokeColor=#C6B45D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1920" y="720" width="620" height="260" as="geometry" /></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="use-cases" name="04 - Sơ đồ ca sử dụng">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="u-title" value="&lt;b&gt;CA SỬ DỤNG - ỨNG DỤNG WEB VIRTUAL PET&lt;/b&gt;&lt;br&gt;Tác nhân và chức năng tương ứng với các route đang chạy và luồng frontend." style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1250" height="55" as="geometry" /></mxCell>
      <mxCell id="u-boundary" value="Ứng dụng web Virtual Pet" style="swimlane;html=1;startSize=34;rounded=0;fillColor=#F8FBFD;swimlaneFillColor=#EAF2F8;strokeColor=#68849B;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="1110" height="940" as="geometry" /></mxCell>
      <mxCell id="u-player" value="Người chơi" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="100" y="400" width="70" height="130" as="geometry" /></mxCell>
      <mxCell id="u-worker" value="Worker chấm bài" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1510" y="730" width="90" height="130" as="geometry" /></mxCell>
      <mxCell id="u-auth" value="Đăng ký, đăng nhập, đăng xuất&lt;br&gt;Quản lý phiên và tài khoản&lt;br&gt;Xác minh email / đặt lại mật khẩu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=13;" vertex="1" parent="u-boundary"><mxGeometry x="50" y="75" width="300" height="100" as="geometry" /></mxCell>
      <mxCell id="u-state" value="Xem trạng thái game, danh mục cửa hàng&lt;br&gt;và tiến độ học tập" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=13;" vertex="1" parent="u-boundary"><mxGeometry x="410" y="75" width="300" height="90" as="geometry" /></mxCell>
      <mxCell id="u-pet" value="Chăm sóc thú cưng&lt;br&gt;cho ăn, chơi, ngủ, đánh thức, tắm&lt;br&gt;đổi tên / chọn loài" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#4D9A69;fontSize=13;" vertex="1" parent="u-boundary"><mxGeometry x="50" y="245" width="310" height="110" as="geometry" /></mxCell>
      <mxCell id="u-shop" value="Mua vật phẩm&lt;br&gt;xem túi đồ / trang bị đồ trang trí" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#4D9A69;fontSize=13;" vertex="1" parent="u-boundary"><mxGeometry x="430" y="245" width="300" height="95" as="geometry" /></mxCell>
      <mxCell id="u-study" value="Học lập trình&lt;br&gt;theo dõi hoạt động / hoàn thành cấp độ&lt;br&gt;nhận điểm, xu và thay đổi chỉ số thú cưng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=13;" vertex="1" parent="u-boundary"><mxGeometry x="790" y="245" width="285" height="115" as="geometry" /></mxCell>
      <mxCell id="u-practice" value="Chơi trò nhỏ Practice&lt;br&gt;bắt đầu, theo dõi, bỏ dở, kết thúc&lt;br&gt;lưu điểm cao nhất và phần thưởng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=13;" vertex="1" parent="u-boundary"><mxGeometry x="50" y="450" width="310" height="115" as="geometry" /></mxCell>
      <mxCell id="u-short" value="Nộp bài tập trả lời ngắn&lt;br&gt;xem điểm và tiến độ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=13;" vertex="1" parent="u-boundary"><mxGeometry x="430" y="455" width="300" height="95" as="geometry" /></mxCell>
      <mxCell id="u-code" value="Nộp mã nguồn C++&lt;br&gt;truy vấn trạng thái chấm và kết quả" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FCEDE7;strokeColor=#CC7A4A;fontSize=13;" vertex="1" parent="u-boundary"><mxGeometry x="790" y="455" width="300" height="100" as="geometry" /></mxCell>
      <mxCell id="u-settings" value="Cập nhật âm thanh / mật khẩu / email&lt;br&gt;xác minh hoặc đặt lại thông tin đăng nhập" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=13;" vertex="1" parent="u-boundary"><mxGeometry x="250" y="675" width="340" height="100" as="geometry" /></mxCell>
      <mxCell id="u-grade" value="Nhận bài mã nguồn đang chờ&lt;br&gt;chạy các ca kiểm thử đã cấu hình&lt;br&gt;lưu điểm và thưởng cho lần được chấp nhận đầu tiên" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FCEDE7;strokeColor=#CC7A4A;fontSize=13;" vertex="1" parent="u-boundary"><mxGeometry x="760" y="675" width="340" height="115" as="geometry" /></mxCell>
      <mxCell id="u-a1" edge="1" parent="1" source="u-player" target="u-auth" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u-a2" edge="1" parent="1" source="u-player" target="u-state" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u-a3" edge="1" parent="1" source="u-player" target="u-pet" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u-a4" edge="1" parent="1" source="u-player" target="u-shop" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u-a5" edge="1" parent="1" source="u-player" target="u-study" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u-a6" edge="1" parent="1" source="u-player" target="u-practice" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u-a7" edge="1" parent="1" source="u-player" target="u-short" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u-a8" edge="1" parent="1" source="u-player" target="u-code" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u-a9" edge="1" parent="1" source="u-player" target="u-settings" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u-a10" edge="1" parent="1" source="u-worker" target="u-grade" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u-dep" value="tác vụ đang chờ" edge="1" parent="1" source="u-code" target="u-grade" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="u-note" value="Study nhận correctAnswers do client gửi; Practice nhận số eaten do client gửi. Máy chủ lưu tiến độ/phần thưởng nhưng không tự kiểm tra lại đáp án hay chạy lại hoạt động phía client." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9DE;strokeColor=#C6B45D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="950" width="830" height="100" as="geometry" /></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="sequence-pet-shop" name="05 - Sơ đồ tuần tự: mua vật phẩm và chăm thú cưng">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1120" math="0" shadow="0"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="s1-title" value="&lt;b&gt;TUẦN TỰ 1 - MUA VẬT PHẨM VÀ CHO THÚ CƯNG ĂN&lt;/b&gt;&lt;br&gt;Phiên được xác thực bằng cookie; mua hàng và cho ăn là hai yêu cầu riêng." style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1300" height="55" as="geometry" /></mxCell>
      <mxCell id="s1-player" value="Người chơi" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="45" y="100" width="70" height="100" as="geometry" /></mxCell>
      <mxCell id="s1-ui" value="Trình duyệt: app.js / api.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F3FF;strokeColor=#4A86C5;" vertex="1" parent="1"><mxGeometry x="220" y="110" width="220" height="60" as="geometry" /></mxCell>
      <mxCell id="s1-route" value="HttpServer + route()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#4D9A69;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="220" height="60" as="geometry" /></mxCell>
      <mxCell id="s1-catalog" value="Catalog: shopItem(id)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C89A32;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="210" height="60" as="geometry" /></mxCell>
      <mxCell id="s1-db" value="Server::Database" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#4D9A69;" vertex="1" parent="1"><mxGeometry x="1130" y="110" width="210" height="60" as="geometry" /></mxCell>
      <mxCell id="s1-sql" value="SQLite" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF4D6;strokeColor=#C89A32;" vertex="1" parent="1"><mxGeometry x="1450" y="105" width="150" height="70" as="geometry" /></mxCell>
      <mxCell id="s1-l1" value="" style="dashed=1;html=1;strokeColor=#9AA9B5;" vertex="1" parent="1"><mxGeometry x="330" y="175" width="1" height="700" as="geometry" /></mxCell><mxCell id="s1-l2" value="" style="dashed=1;html=1;strokeColor=#9AA9B5;" vertex="1" parent="1"><mxGeometry x="630" y="175" width="1" height="700" as="geometry" /></mxCell><mxCell id="s1-l3" value="" style="dashed=1;html=1;strokeColor=#9AA9B5;" vertex="1" parent="1"><mxGeometry x="935" y="175" width="1" height="700" as="geometry" /></mxCell><mxCell id="s1-l4" value="" style="dashed=1;html=1;strokeColor=#9AA9B5;" vertex="1" parent="1"><mxGeometry x="1235" y="175" width="1" height="700" as="geometry" /></mxCell><mxCell id="s1-l5" value="" style="dashed=1;html=1;strokeColor=#9AA9B5;" vertex="1" parent="1"><mxGeometry x="1525" y="180" width="1" height="690" as="geometry" /></mxCell>
      <mxCell id="s1-m1" value="POST /api/shop/purchases {itemId,quantity} + cookie" edge="1" parent="1" source="s1-ui" target="s1-route" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1-m2" value="đổi vp_session thành userId" edge="1" parent="1" source="s1-route" target="s1-db" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1-m3" value="GET /api/shop -&gt; shopCatalog()" edge="1" parent="1" source="s1-route" target="s1-catalog" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1-m4" value="purchase(userId,itemId,quantity)" edge="1" parent="1" source="s1-route" target="s1-db" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1-m5" value="giao dịch: trừ xu, cập nhật/tạo vật phẩm trong túi, ghi lịch sử mua" edge="1" parent="1" source="s1-db" target="s1-sql" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1-m6" value="kết quả mua hàng" edge="1" parent="1" source="s1-db" target="s1-route" style="dashed=1;endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1-m7" value="POST /api/pet/feed {itemId} + cookie" edge="1" parent="1" source="s1-ui" target="s1-route" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1-m8" value="feed(userId,itemId)" edge="1" parent="1" source="s1-route" target="s1-db" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1-m9" value="kiểm tra đồ ăn đang sở hữu; cập nhật chỉ số thú cưng; trừ số lượng trong túi" edge="1" parent="1" source="s1-db" target="s1-sql" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1-m10" value="kết quả + trạng thái game mới" edge="1" parent="1" source="s1-route" target="s1-ui" style="dashed=1;endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1-m11" value="mua hàng/cho ăn: shopItem(itemId)" edge="1" parent="1" source="s1-db" target="s1-catalog" style="dashed=1;endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="s1-note" value="Route API không gọi các lớp miền C++ Shop/Inventory/Pet độc lập. Giới hạn số lượng đồ trang trí và quy tắc mua được áp dụng ở schema/cơ sở dữ liệu khi chạy." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9DE;strokeColor=#C6B45D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="925" width="1120" height="100" as="geometry" /></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="sequence-study-practice" name="06 - Sơ đồ tuần tự: Study và Practice">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="s2-title" value="&lt;b&gt;TUẦN TỰ 2 - HOÀN THÀNH CẤP STUDY VÀ NHẬN THƯỞNG PRACTICE&lt;/b&gt;&lt;br&gt;Hoạt động trên trình duyệt được gửi đến API đã xác thực và lưu lại." style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1300" height="55" as="geometry" /></mxCell>
      <mxCell id="s2-player" value="Người chơi" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="45" y="100" width="70" height="100" as="geometry" /></mxCell><mxCell id="s2-ui" value="study.js / practice.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F3FF;strokeColor=#4A86C5;" vertex="1" parent="1"><mxGeometry x="240" y="110" width="220" height="60" as="geometry" /></mxCell><mxCell id="s2-route" value="route()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#4D9A69;" vertex="1" parent="1"><mxGeometry x="570" y="110" width="180" height="60" as="geometry" /></mxCell><mxCell id="s2-db" value="Server::Database" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#4D9A69;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="210" height="60" as="geometry" /></mxCell><mxCell id="s2-sql" value="SQLite" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF4D6;strokeColor=#C89A32;" vertex="1" parent="1"><mxGeometry x="1230" y="105" width="150" height="70" as="geometry" /></mxCell>
      <mxCell id="s2-l1" value="" style="dashed=1;html=1;strokeColor=#9AA9B5;" vertex="1" parent="1"><mxGeometry x="350" y="175" width="1" height="710" as="geometry" /></mxCell><mxCell id="s2-l2" value="" style="dashed=1;html=1;strokeColor=#9AA9B5;" vertex="1" parent="1"><mxGeometry x="660" y="175" width="1" height="710" as="geometry" /></mxCell><mxCell id="s2-l3" value="" style="dashed=1;html=1;strokeColor=#9AA9B5;" vertex="1" parent="1"><mxGeometry x="985" y="175" width="1" height="710" as="geometry" /></mxCell><mxCell id="s2-l4" value="" style="dashed=1;html=1;strokeColor=#9AA9B5;" vertex="1" parent="1"><mxGeometry x="1305" y="180" width="1" height="700" as="geometry" /></mxCell>
      <mxCell id="s2-m1" value="POST /api/study/time {action}" edge="1" parent="1" source="s2-ui" target="s2-route" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2-m2" value="updateStudyActivity(userId,...)" edge="1" parent="1" source="s2-route" target="s2-db" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2-m3" value="lưu hoạt động và mức suy giảm chỉ số" edge="1" parent="1" source="s2-db" target="s2-sql" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2-m4" value="POST /api/study/complete {level,tier,correctAnswers}" edge="1" parent="1" source="s2-ui" target="s2-route" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2-m5" value="completeStudyStage(userId,...)" edge="1" parent="1" source="s2-route" target="s2-db" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2-m6" value="thứ tự cấp độ, trạng thái hoàn thành, điểm/xu và trạng thái thú cưng" edge="1" parent="1" source="s2-db" target="s2-sql" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2-m7" value="POST /api/practice/game/start {gameId}" edge="1" parent="1" source="s2-ui" target="s2-route" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2-m8" value="startPracticeGame(userId,gameId)" edge="1" parent="1" source="s2-route" target="s2-db" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2-m9" value="lưu ván chơi đang hoạt động" edge="1" parent="1" source="s2-db" target="s2-sql" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2-m10" value="POST /api/practice/finish {gameId,eaten}" edge="1" parent="1" source="s2-ui" target="s2-route" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2-m11" value="finishPracticeGame(userId,gameId,eaten)" edge="1" parent="1" source="s2-route" target="s2-db" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2-m12" value="tính idempotent, điểm/xu, bản ghi và chỉ số thú cưng" edge="1" parent="1" source="s2-db" target="s2-sql" style="endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2-m13" value="kết quả và trạng thái mới" edge="1" parent="1" source="s2-route" target="s2-ui" style="dashed=1;endArrow=block;html=1;fontSize=12;strokeWidth=2;endSize=12;endFill=1;" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="s2-note" value="Trình duyệt gửi correctAnswers và eaten; API ghi tiến độ/phần thưởng nhưng không tự xác minh đáp án hay tính lại điểm trò chơi." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9DE;strokeColor=#C6B45D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="930" width="1120" height="90" as="geometry" /></mxCell>
