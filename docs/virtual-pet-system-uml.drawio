<mxfile host="app.diagrams.net" modified="2026-10-30T00:00:00.000Z" agent="GitHub Copilot" version="24.7.17" type="device">
  <diagram id="architecture" name="01 - Kiến trúc và lý do thiết kế">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="a-title" value="&lt;b&gt;VIRTUAL PET - KIẾN TRÚC HỆ THỐNG&lt;/b&gt;&lt;br&gt;Luồng chạy thực tế và các mô-đun C++ độc lập theo mã nguồn" style="text;html=1;align=left;verticalAlign=middle;fontSize=23;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1300" height="65" as="geometry" /></mxCell>
      <mxCell id="a-browser" value="&lt;b&gt;Người chơi / Trình duyệt&lt;/b&gt;&lt;br&gt;index.html, study.html, practice.html, submission.html&lt;br&gt;JS: api, auth, app, study, practice, submission" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="190" width="300" height="125" as="geometry" /></mxCell>
      <mxCell id="a-http" value="&lt;b&gt;HttpServer&lt;/b&gt;&lt;br&gt;Winsock, chỉ dùng HTTP, xử lý từng yêu cầu một&lt;br&gt;HttpRequest / HttpResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#4D9A69;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="290" height="125" as="geometry" /></mxCell>
      <mxCell id="a-route" value="&lt;b&gt;hàm tự do route()&lt;/b&gt;&lt;br&gt;server_main.cpp điều phối route, xác thực, kiểm tra dữ liệu và ánh xạ phản hồi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#4D9A69;fontSize=14;" vertex="1" parent="1"><mxGeometry x="790" y="190" width="310" height="125" as="geometry" /></mxCell>
      <mxCell id="a-db" value="&lt;b&gt;Server::Database (API đang chạy)&lt;/b&gt;&lt;br&gt;CRUD trên SQLite, quy tắc nghiệp vụ và giao dịch&lt;br&gt;Tài khoản, thú cưng, cửa hàng, Study, Practice và bài nộp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#4D9A69;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1190" y="190" width="350" height="125" as="geometry" /></mxCell>
      <mxCell id="a-sql" value="&lt;b&gt;Cơ sở dữ liệu SQLite khi chạy&lt;/b&gt;&lt;br&gt;database/schema.sql&lt;br&gt;users, pets, sessions, inventory, progress, submissions, rewards" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1250" y="455" width="270" height="145" as="geometry" /></mxCell>
      <mxCell id="a-worker" value="Bộ xử lý chấm bài Python&lt;br&gt;Nhận bài nộp đang chờ; biên dịch/chạy C++17 cục bộ; lưu kết quả và thưởng cho lần được chấp nhận đầu tiên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEDE7;strokeColor=#CC7A4A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="780" y="455" width="350" height="135" as="geometry" /></mxCell>
      <mxCell id="a-cases" value="&lt;b&gt;Bộ ca kiểm thử JSON&lt;/b&gt;&lt;br&gt;backend/evaluator/testcases/&amp;lt;exercise_id&amp;gt;.json" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9DE;strokeColor=#C6B45D;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="650" width="350" height="90" as="geometry" /></mxCell>
      <mxCell id="a-domain" value="&lt;b&gt;Mô hình miền độc lập (C++)&lt;/b&gt;&lt;br&gt;Game / GameState, PlayerData, Pet, Shop, Inventory, Item, Reward&lt;br&gt;Được biên dịch và kiểm thử riêng; route() hiện tại không gọi đến" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="455" width="340" height="140" as="geometry" /></mxCell>
      <mxCell id="a-repo" value="&lt;b&gt;Mô-đun repository độc lập (C++)&lt;/b&gt;&lt;br&gt;IUser/IPet/IInventory/IGameRepository + các phần triển khai SQLite&lt;br&gt;Thiết kế lưu trữ riêng; route HTTP đang chạy không sử dụng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="455" width="300" height="140" as="geometry" /></mxCell>
      <mxCell id="a-auth" value="&lt;b&gt;Mô-đun AuthService (C++)&lt;/b&gt;&lt;br&gt;Phần xác thực độc lập; API đang chạy xác thực qua route() và Server::Database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E7;strokeColor=#A48542;fontSize=13;" vertex="1" parent="1"><mxGeometry x="45" y="665" width="340" height="110" as="geometry" /></mxCell>
      <mxCell id="a-e1" value="HTTP + JSON" style="endArrow=block;html=1;strokeColor=#4A86C5;strokeWidth=2;endSize=12;endFill=1;" edge="1" parent="1" source="a-browser" target="a-http"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="a-e2" value="callback xử lý yêu cầu" style="endArrow=block;html=1;strokeColor=#4D9A69;strokeWidth=2;endSize=12;endFill=1;" edge="1" parent="1" source="a-http" target="a-route"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="a-e3" value="gọi trực tiếp" style="endArrow=block;html=1;strokeColor=#4D9A69;strokeWidth=2;endSize=12;endFill=1;" edge="1" parent="1" source="a-route" target="a-db"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="a-e4" value="SQL" style="endArrow=block;html=1;strokeColor=#C89A32;strokeWidth=2;endSize=12;endFill=1;" edge="1" parent="1" source="a-db" target="a-sql"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="a-e5" value="nhận bài/cập nhật" style="endArrow=block;html=1;strokeColor=#CC7A4A;strokeWidth=2;endSize=12;endFill=1;" edge="1" parent="1" source="a-worker" target="a-sql"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="a-e6" value="tải ca kiểm thử" style="dashed=1;endArrow=open;html=1;strokeColor=#CC7A4A;strokeWidth=2;endSize=12;endFill=0;" edge="1" parent="1" source="a-worker" target="a-cases"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="a-patterns" value="&lt;b&gt;Trừu tượng hóa và các mẫu thiết kế có trong mã nguồn&lt;/b&gt;&lt;br&gt;Kế thừa / đa hình: Pet và Item trừu tượng cung cấp hợp đồng chung; Cat/Dog và Food/Decoration chuyên biệt hóa hành vi và kiểu. Facade: Game gom các thao tác miền sau một API cho luồng game độc lập; route HTTP đang chạy không gọi Game. Repository: các interface tách hợp đồng lưu trữ miền khỏi phần triển khai SQLite; API HTTP hiện gọi trực tiếp Server::Database. RAII: DatabaseConnection, Statement và Transaction quản lý tài nguyên SQLite; Transaction tự rollback nếu chưa hoàn tất. Lý do phân lớp: tách giao diện, giao vận, miền, lưu trữ và chấm bài để có thể thay đổi và kiểm thử độc lập. Hệ thống đang chạy mới phân lớp một phần: route() điều phối nghiệp vụ, còn Database gộp quy tắc với SQL. Không kết luận có Strategy/Factory/Observer/Singleton vì mã nguồn không thể hiện các mẫu này." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9DE;strokeColor=#C6B45D;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="825" width="1120" height="190" as="geometry" /></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="domain-classes" name="02 - Sơ đồ lớp miền">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2600" pageHeight="1800" math="0" shadow="0"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="d-title" value="&lt;b&gt;SƠ ĐỒ LỚP MIỀN&lt;/b&gt;&lt;br&gt;+ công khai, - riêng tư, # được bảo vệ. Tam giác rỗng: kế thừa; đường liền: liên kết; kim cương rỗng: kết tập; kim cương đặc: hợp thành; mũi tên nét đứt: phụ thuộc." style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1650" height="60" as="geometry" /></mxCell>
      <mxCell id="d-item" value="&lt;b&gt;&amp;lt;&amp;lt;trừu tượng&amp;gt;&amp;gt; Item&lt;/b&gt;&lt;hr&gt;# id : int&lt;br&gt;# name, description, imagePath : string&lt;br&gt;# price : int&lt;hr&gt;+ Item(id,name,description,price,imagePath)&lt;br&gt;+ virtual ~Item()&lt;br&gt;+ getId/getName/getDescription/getPrice/getImagePath() const&lt;br&gt;+ getType() const : ItemType = 0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="370" height="240" as="geometry" /></mxCell>
      <mxCell id="d-food" value="&lt;b&gt;Food : Item&lt;/b&gt;&lt;hr&gt;- hungerRestore, happinessRestore : int&lt;hr&gt;+ Food(...,hungerRestore,happinessRestore=0)&lt;br&gt;+ getHungerRestore/getHappinessRestore() const&lt;br&gt;+ getType() const override" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#EAF7EE;strokeColor=#4D9A69;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="360" height="190" as="geometry" /></mxCell>
      <mxCell id="d-decoration" value="&lt;b&gt;Decoration : Item&lt;/b&gt;&lt;hr&gt;- slot : DecorationSlot&lt;hr&gt;+ Decoration(...,slot)&lt;br&gt;+ getSlot() const&lt;br&gt;+ getType() const override" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#EAF7EE;strokeColor=#4D9A69;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="320" width="360" height="170" as="geometry" /></mxCell>
      <mxCell id="d-pet" value="&lt;b&gt;&amp;lt;&amp;lt;trừu tượng&amp;gt;&amp;gt; Pet&lt;/b&gt;&lt;br&gt;- id : int; name : string&lt;br&gt;- level, health, happiness, hunger, energy, experience : int&lt;br&gt;- equipment : map&amp;lt;DecorationSlot,int&amp;gt;&lt;br&gt;# addHappiness/clampStat/changeHealth/changeHappiness/changeHunger/changeEnergy(...)&lt;br&gt;+ Pet(...); virtual ~Pet()&lt;br&gt;+ các getter; setName/setHealth/setHappiness/setHunger/setEnergy/setExperience&lt;br&gt;+ feed(Food) : ActionResult; play/sleep/bath() : ActionResult&lt;br&gt;+ eat(Food) : bool; updateOverTime(minutes); applyTimePassed(ticks)&lt;br&gt;+ getType/getSound() : string = 0&lt;br&gt;+ equip/unequip/getEquipped/getEquipment()&lt;br&gt;+ MIN/MAX_STAT và các hằng số thao tác/tick" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="490" height="360" as="geometry" /></mxCell>
      <mxCell id="d-cat" value="&lt;b&gt;Cat : Pet&lt;/b&gt;&lt;hr&gt;+ Cat(id,name,stats...)&lt;br&gt;+ getType/getSound() const override&lt;br&gt;+ play() : ActionResult override" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#EAF7EE;strokeColor=#4D9A69;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="560" width="330" height="150" as="geometry" /></mxCell>
      <mxCell id="d-dog" value="&lt;b&gt;Dog : Pet&lt;/b&gt;&lt;hr&gt;+ Dog(id,name,stats...)&lt;br&gt;+ getType/getSound() const override&lt;br&gt;+ play() : ActionResult override" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#EAF7EE;strokeColor=#4D9A69;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="750" width="330" height="150" as="geometry" /></mxCell>
      <mxCell id="d-slot" value="&lt;b&gt;InventorySlot (cấu trúc)&lt;/b&gt;&lt;hr&gt;+ item : shared_ptr&amp;lt;Item&amp;gt;&lt;br&gt;+ quantity : int" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="100" width="330" height="120" as="geometry" /></mxCell>
      <mxCell id="d-inventory" value="&lt;b&gt;Inventory&lt;/b&gt;&lt;hr&gt;- slots : vector&amp;lt;InventorySlot&amp;gt;&lt;hr&gt;- findSlotIndex(itemId) const : int&lt;br&gt;+ Inventory()&lt;br&gt;+ addItem(item,quantity)&lt;br&gt;+ removeItem(itemId,quantity) : bool&lt;br&gt;+ getQuantity/hasItem/isEmpty() const&lt;br&gt;+ getSlots() const" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="280" width="350" height="220" as="geometry" /></mxCell>
      <mxCell id="d-player" value="&lt;b&gt;PlayerData&lt;/b&gt;&lt;hr&gt;- userId : int; name : string; coins : int&lt;br&gt;- inventory : Inventory&lt;br&gt;- pet : shared_ptr&amp;lt;Pet&amp;gt;&lt;hr&gt;+ PlayerData(userId,name,coins=0)&lt;br&gt;+ getId/getUserId/getName/getCoins() const&lt;br&gt;+ addCoins/spendCoins()&lt;br&gt;+ getInventory() const/non-const&lt;br&gt;+ setPet/getPet(); feedPet(foodItemId)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="100" width="390" height="270" as="geometry" /></mxCell>
      <mxCell id="d-user" value="&lt;b&gt;User (mô hình tài khoản; tách biệt với PlayerData)&lt;/b&gt;&lt;hr&gt;- id : int; username,email,passwordSalt,passwordHash : string&lt;br&gt;- createdAt,lastLoginAt,name : string; coins : int&lt;br&gt;- inventory : Inventory; pet : shared_ptr&amp;lt;Pet&amp;gt;&lt;hr&gt;+ hàm tạo và getter/setter tài khoản&lt;br&gt;+ isValidUsername/Password/Email(...) : bool static&lt;br&gt;+ getInventory/setPet/getPet/feedPet(...)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1880" y="100" width="500" height="250" as="geometry" /></mxCell>
      <mxCell id="d-shop" value="&lt;b&gt;Shop&lt;/b&gt;&lt;hr&gt;- items : vector&amp;lt;shared_ptr&amp;lt;Item&amp;gt;&amp;gt;&lt;hr&gt;+ Shop/getItems/getItemsForSale/getFoods/getDecorations/getDecorationsBySlot&lt;br&gt;+ getItemById(itemId)&lt;br&gt;+ purchase(PlayerData&amp;,itemId,quantity=1) : ActionResult&lt;br&gt;+ buyItem(PlayerData&amp;,itemId) : bool tương thích cũ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1880" y="430" width="500" height="220" as="geometry" /></mxCell>
      <mxCell id="d-reward" value="&lt;b&gt;Reward&lt;/b&gt;&lt;hr&gt;- coins : int; items : vector&amp;lt;shared_ptr&amp;lt;Item&amp;gt;&amp;gt;&lt;hr&gt;+ Reward(coins=0); addItem(item)&lt;br&gt;+ getCoins/getItems() const&lt;br&gt;+ grantTo(PlayerData&amp;) const" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1880" y="720" width="500" height="170" as="geometry" /></mxCell>
      <mxCell id="d-state" value="&lt;b&gt;GameState&lt;/b&gt;&lt;hr&gt;- status : GameStatus&lt;br&gt;- player : unique_ptr&amp;lt;PlayerData&amp;gt;&lt;br&gt;- pet : shared_ptr&amp;lt;Pet&amp;gt;&lt;br&gt;- shop : unique_ptr&amp;lt;Shop&amp;gt;&lt;hr&gt;+ initialize/restore/getters/setStatus" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="620" width="390" height="220" as="geometry" /></mxCell>
      <mxCell id="d-game" value="&lt;b&gt;Game (Facade)&lt;/b&gt;&lt;hr&gt;- gameState : GameState; timeCarrySeconds : int&lt;hr&gt;+ initialize/start/pause/resume/end&lt;br&gt;+ feed/play/sleep/bath/buy/decorate/unequipDecoration&lt;br&gt;+ claimReward/updateOverTime/exportSnapshot/importSnapshot&lt;br&gt;+ các getter cho status/player/pet/shop/inventory/coins" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#E8F3FF;strokeColor=#4A86C5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="980" width="430" height="260" as="geometry" /></mxCell>
      <mxCell id="d-result" value="&lt;b&gt;ActionResult (cấu trúc)&lt;/b&gt;&lt;hr&gt;+ code : ActionCode&lt;br&gt;+ message : string; levelsGained : int&lt;hr&gt;+ ok/success/failure" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="1020" width="300" height="145" as="geometry" /></mxCell>
      <mxCell id="d-snapshot" value="&lt;b&gt;Các bản ghi GameSnapshot (cấu trúc)&lt;/b&gt;&lt;hr&gt;GameSnapshot: userId,userName,coins,pet,inventory,equipment&lt;br&gt;PetSnapshot: id,name,level,health,happiness,hunger,energy,experience&lt;br&gt;InventoryEntrySnapshot: itemId,quantity&lt;br&gt;EquipmentEntrySnapshot: slot,itemId" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="1210" width="420" height="165" as="geometry" /></mxCell>
      <mxCell id="d-submission" value="&lt;b&gt;Submission (cấu trúc)&lt;/b&gt;&lt;hr&gt;+ id,userId,exerciseId : long long&lt;br&gt;+ sourceCode,language,message,submittedAt,finishedAt : string&lt;br&gt;+ status : SubmissionStatus; score : int&lt;hr&gt;+ isFinished/isAccepted; validateSubmission(...)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="490" height="200" as="geometry" /></mxCell>
      <mxCell id="d-testcase" value="&lt;b&gt;TestCase (cấu trúc)&lt;/b&gt;&lt;hr&gt;+ id,exerciseId : long long; input,expectedOutput : string&lt;br&gt;+ hidden : bool; ordinal,timeLimitMs,memoryLimitMb : int&lt;hr&gt;+ normalizeJudgeOutput/outputsMatch/validateTestCase" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fillColor=#FFF4D6;strokeColor=#C89A32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="1080" width="470" height="190" as="geometry" /></mxCell>
      <mxCell id="d-study" value="&lt;b&gt;Các hàm tính điểm Study (Exercise.cpp)&lt;/b&gt;&lt;hr&gt;+ studyPointsPerCorrectAnswer(tier)&lt;br&gt;+ studyCompletionBonus(tier)&lt;br&gt;+ studyCompletionCoins(tier)&lt;br&gt;+ studyStagePasses(correctAnswers,questionCount=5)&lt;br&gt;Đây là các hàm tự do; Exercise.h không khai báo lớp Exercise." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9DE;strokeColor=#C6B45D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="600" height="170" as="geometry" /></mxCell>
      <mxCell id="d-empty" value="DailyQuest.h/.cpp hiện để trống nên chưa có lớp nhiệm vụ được triển khai. User.cpp chưa hoàn chỉnh: getName/getCoins/addCoins/spendCoins đã khai báo nhưng chưa định nghĩa; coins chưa được khởi tạo." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9DE;strokeColor=#C6B45D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="1400" width="520" height="90" as="geometry" /></mxCell>
      <mxCell id="d-enums" value="&lt;b&gt;Các enum&lt;/b&gt;&lt;hr&gt;ItemType: FOOD, DECORATION&lt;br&gt;DecorationSlot: HAT, BACKGROUND, FLOOR&lt;br&gt;GameStatus: NOT_STARTED, RUNNING, PAUSED, ENDED&lt;br&gt;ActionCode: OK, INVALID_STATE, INVALID_ARGUMENT, ITEM_NOT_FOUND, NOT_FOOD, NOT_DECORATION, NOT_OWNED, ALREADY_OWNED, NOT_ENOUGH_COINS, PET_TOO_TIRED, ENERGY_FULL, INVALID_SNAPSHOT&lt;br&gt;SubmissionStatus: QUEUED, EVALUATING, ACCEPTED, WRONG_ANSWER, COMPILATION_ERROR, RUNTIME_ERROR, TIME_LIMIT_EXCEEDED, MEMORY_LIMIT_EXCEEDED, INTERNAL_ERROR" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9DE;strokeColor=#C6B45D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="1390" width="1050" height="230" as="geometry" /></mxCell>
      <mxCell id="d-inherit1" edge="1" parent="1" source="d-food" target="d-item" style="endArrow=block;endFill=0;html=1;strokeWidth=2;endSize=12;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d-inherit2" edge="1" parent="1" source="d-decoration" target="d-item" style="endArrow=block;endFill=0;html=1;strokeWidth=2;endSize=12;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d-inherit3" edge="1" parent="1" source="d-cat" target="d-pet" style="endArrow=block;endFill=0;html=1;strokeWidth=2;endSize=12;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d-inherit4" edge="1" parent="1" source="d-dog" target="d-pet" style="endArrow=block;endFill=0;html=1;strokeWidth=2;endSize=12;" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="d-comp1" value="0..*" edge="1" parent="1" source="d-inventory" target="d-slot" style="startArrow=diamond;startFill=1;endArrow=none;html=1;strokeWidth=2;startSize=12;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d-assoc1" value="shared_ptr" edge="1" parent="1" source="d-slot" target="d-item" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="d-comp2" value="1" edge="1" parent="1" source="d-player" target="d-inventory" style="startArrow=diamond;startFill=1;endArrow=none;html=1;strokeWidth=2;startSize=12;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d-assoc2" value="0..1, dùng chung" edge="1" parent="1" source="d-player" target="d-pet" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="d-comp3" value="1" edge="1" parent="1" source="d-user" target="d-inventory" style="startArrow=diamond;startFill=1;endArrow=none;html=1;strokeWidth=2;startSize=12;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d-assoc3" value="0..1, dùng chung" edge="1" parent="1" source="d-user" target="d-pet" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="d-assoc4" value="các Item dùng chung trong danh mục" edge="1" parent="1" source="d-shop" target="d-item" style="startArrow=diamond;startFill=0;endArrow=none;html=1;strokeWidth=2;startSize=12;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d-dep1" value="sử dụng" edge="1" parent="1" source="d-shop" target="d-player" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="d-assoc5" value="các Item dùng chung trong phần thưởng" edge="1" parent="1" source="d-reward" target="d-item" style="startArrow=diamond;startFill=0;endArrow=none;html=1;strokeWidth=2;startSize=12;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d-dep2" value="trao cho" edge="1" parent="1" source="d-reward" target="d-player" style="dashed=1;endArrow=open;html=1;strokeWidth=2;endSize=12;endFill=0;" ><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="d-comp4" value="sở hữu" edge="1" parent="1" source="d-state" target="d-player" style="startArrow=diamond;startFill=1;endArrow=none;html=1;strokeWidth=2;startSize=12;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d-assoc6" value="Pet dùng chung" edge="1" parent="1" source="d-state" target="d-pet" style="endArrow=none;html=1;strokeWidth=2;" ><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d-comp5" value="sở hữu" edge="1" parent="1" source="d-state" target="d-shop" style="startArrow=diamond;startFill=1;endArrow=none;html=1;strokeWidth=2;startSize=12;" ><mxGeometry relative="1" as="geometry"/></mxCell>
